# OrderRescue runs against Binance Spot Testnet. There is no configuration of
# this build that trades real money: MAINNET is refused at startup, and so is a
# mainnet BINANCE_BASE_URL.

# Get a key pair from https://testnet.binance.vision (GitHub sign-in, then
# "Generate HMAC_SHA256 Key"). Without these, OrderRescue starts read-only and
# refuses to execute rather than pretending an order was placed.
BINANCE_API_KEY=
BINANCE_API_SECRET=

BINANCE_BASE_URL=https://testnet.binance.vision
BINANCE_RECV_WINDOW_MS=5000
BINANCE_TIMEOUT_MS=10000

ORDERRESCUE_ENV=TESTNET
ORDERRESCUE_HOST=127.0.0.1
ORDERRESCUE_PORT=4319
ORDERRESCUE_DB_PATH=./data/journal.db

# Mutation routes require this value in an X-OrderRescue-Session header.
# Leave it unset and the server generates one per process and prints it.
ORDERRESCUE_SESSION_SECRET=

# Hard ceiling on the notional of any single intent, in quote asset units.
ORDERRESCUE_MAX_NOTIONAL=25

# Testnet-only fault injection. Set to false to remove the routes entirely.
ORDERRESCUE_FAULT_LAB=true

# How much evidence is required before "no such order" is treated as settled.
ORDERRESCUE_ABSENCE_MIN_ATTEMPTS=5
ORDERRESCUE_ABSENCE_WINDOW_MS=60000

ORDERRESCUE_RECONCILE_BASE_MS=1500
ORDERRESCUE_RECONCILE_MAX_MS=20000
